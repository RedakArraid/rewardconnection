# Base de données utilisée quand l'application tourne directement sur l'hôte.
DATABASE_URL="postgresql://reward:change-this-db-password@localhost:5432/rewardconnection?schema=public"
POSTGRES_PASSWORD="change-this-db-password"

# Authentification
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://reward.home.arpa:3000"
# auto = Secure si APP_URL commence par https://
AUTH_COOKIE_SECURE="auto"

# 1 jeton = ce nombre de minutes
TOKEN_MINUTES="60"

# MikroTik RouterOS REST API
MIKROTIK_ENABLED="false"
MIKROTIK_BASE_URL="https://192.168.88.1"
MIKROTIK_USERNAME="rewardconnection"
MIKROTIK_PASSWORD="replace-with-a-long-router-password"
# true uniquement si tu utilises un certificat local/non approuvé.
MIKROTIK_ALLOW_INSECURE_TLS="false"
MIKROTIK_REQUEST_TIMEOUT_MS="5000"
MIKROTIK_ADDRESS_LIST="rewardconnection-active"
MIKROTIK_CHILD_SUBNET="192.168.20.0/24"
