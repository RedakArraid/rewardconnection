DATABASE_URL="postgresql://reward:reward@localhost:5432/rewardconnection?schema=public"
AUTH_SECRET="change-me-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# MikroTik RouterOS REST API
MIKROTIK_ENABLED="false"
MIKROTIK_BASE_URL="https://192.168.88.1"
MIKROTIK_USERNAME="rewardconnection"
MIKROTIK_PASSWORD="change-me"
MIKROTIK_ALLOW_INSECURE_TLS="true"
MIKROTIK_ADDRESS_LIST="rewardconnection-active"
MIKROTIK_CHILD_SUBNET="192.168.20.0/24"

# 1 token = this many minutes
TOKEN_MINUTES="60"
